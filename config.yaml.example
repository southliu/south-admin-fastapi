# 可由环境变量 ENVIRONMENT 覆盖
environment: development

# 数据库配置
database:
  url: "mysql+aiomysql://root:your_password@localhost:3306/south_admin?charset=utf8mb4"
  echo: false
  pool_size: 20
  max_overflow: 10
  pool_recycle: 3600

# JWT 配置
jwt:
  secret_key: "your-secret-key-here"
  algorithm: "HS256"
  access_token_expire_minutes: 1440

# 只读模式：为 1 时整个系统除登录外的非 GET 请求全部拒绝；为其他值（如 0）时不生效
readonly:
  enabled: 0

# 操作日志：请求体最大记录长度与日志保留天数
log:
  request_body_limit: 4096
  retention_days: 90
